{
  "name": "studioshare-mascot",
  "version": "1.0.0",
  "private": true,
  "description": "StudioShare Mascot: 3D character pipeline, Compose Multiplatform & Web SDKs, and Desktop Background Agent",
  "type": "module",
  "scripts": {
    "pack": "node pipeline/tools/pack.mjs",
    "pack:sync": "node pipeline/tools/pack.mjs --sync-apps",
